# The app disables prepared statements (DB_PREPARE_THRESHOLD in core/db_pool.py),
# so any packaged PgBouncer version works in transaction mode; no pinning needed.
FROM alpine:3.20

# postgresql-client provides pg_isready for the healthcheck.
RUN apk add --no-cache pgbouncer postgresql-client

# Config and auth file are bind-mounted at runtime, so the image carries no secrets.
RUN addgroup -S pgb && adduser -S -G pgb pgb
USER pgb

EXPOSE 6432

# No -d: Docker supervises the foreground process.
ENTRYPOINT ["pgbouncer"]
CMD ["/etc/pgbouncer/pgbouncer.ini"]
