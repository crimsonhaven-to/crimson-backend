# The official image supplies the server binaries and the `postgres` user; Patroni
# (with its etcd3 client) and pgBackRest are layered on top.
FROM postgres:17-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-psycopg2 \
      pgbackrest curl ca-certificates \
 && pip3 install --no-cache-dir --break-system-packages 'patroni[etcd3]' \
 && rm -rf /var/lib/apt/lists/*

# uid 999 must own the bind-mounted data directory (README §4).
USER postgres

# Replaces the base entrypoint because Patroni, not the image's initdb logic, owns
# the data directory lifecycle.
ENTRYPOINT ["patroni", "/etc/patroni/patroni.yml"]
