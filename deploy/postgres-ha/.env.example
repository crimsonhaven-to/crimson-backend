# Copy to `.env` on each database host. Values marked PER HOST differ between
# hosts; everything else is identical. Replace the example IPs with your own.

# ============================================================================
# This host
# ============================================================================
HOST_IP=192.168.2.100                 # <-- PER HOST: this machine's LAN IP
PATRONI_NAME=crimsondb01                 # <-- PER HOST: unique node name (pg-1 / pg-2 / pg-3)
ETCD_NAME=etcd-1                  # <-- PER HOST: unique etcd name (etcd-1 / etcd-2 / etcd-3)

# Only read when etcd first creates its data dir; `existing` is optional later (README §11).
ETCD_INITIAL_CLUSTER_STATE=new

# ============================================================================
# The cluster (identical on all hosts)
# ============================================================================
PATRONI_SCOPE=crimson-cluster

# All three members, as name=http://IP:2380
ETCD_INITIAL_CLUSTER=etcd-1=http://192.168.2.100:2380,etcd-2=http://192.168.2.101:2380,etcd-3=http://192.168.2.102:2380

# All three client endpoints, as IP:2379
ETCD_CLIENT_HOSTS=192.168.2.100:2379,192.168.2.101:2379,192.168.2.102:2379

# On the RAID1 mount
PGDATA_DIR=/srv/crimson-pgdata
PGBACKREST_REPO=/srv/crimson-pgbackrest

# ============================================================================
# Secrets (identical on all hosts). Generate once: openssl rand -hex 24
# ============================================================================
SUPERUSER_PASSWORD=CHANGE_ME_superuser_password
REPLICATION_PASSWORD=CHANGE_ME_replication_password
PATRONI_RESTAPI_USERNAME=admin
PATRONI_RESTAPI_PASSWORD=CHANGE_ME_restapi_password

# The API's login, used in DATABASE_URL
CRIMSON_APP_USER=crimson
CRIMSON_APP_PASSWORD=CHANGE_ME_app_password
CRIMSON_APP_DB=crimson
