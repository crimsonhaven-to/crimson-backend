# Crimson Backend configuration.
#
# Commented-out lines show the default. Uncommented ones are blanks you fill in.
# Only TMDB_API_KEY is required to boot; every other block self-disables when unset.
#
# NOTE: Compose/Swarm only inject variables listed in a service's `environment:`
# block. This file is for ${...} substitution, not auto-injection.

# --- Required ---------------------------------------------------------------
# TMDB Read Access Token (v4) or legacy API key. Metadata + search need it.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# --- Stream proxy signing ---------------------------------------------------
# HMAC secret for the links minted by /sign, the subtitle/local/manga/IPTV image
# and stream proxies, and cache tickets. MUST be stable across restarts and
# identical on every replica (and equal to each crimson-proxy's
# NITRO_PROXY_SECRET), or signed playback returns intermittent 403s.
# Unset => a random per-process secret (fine for one dev instance only).
#   openssl rand -hex 32
#
# This is the ONE secret to set. Each surface below also reads its own
# *_PROXY_SECRET, but only as a FALLBACK: PROXY_SECRET wins whenever it is set, so
# a per-surface var can never override it. Set those only if you deliberately leave
# PROXY_SECRET empty and want to key each surface separately.
PROXY_SECRET=

# --- External CORS proxy (crimson-proxy) ------------------------------------
# Optional. The backend doesn't resolve third-party sources; the client does, then
# asks /sign for a signed edge link so segment bytes flow CDN -> edge -> viewer.
# Comma-separate several hosts for free failover (one signed link works on all).
# Unset => /sign returns 503 and the client falls back to the extension/backend.
# CRIMSON_PROXY_BASE=https://<site>.netlify.app,https://crimson-proxy.<acct>.workers.dev
# Optional per-source allow-list for the edge path. Empty = every source may use it.
# CRIMSON_PROXY_SOURCES=

# --- Database (PostgreSQL) --------------------------------------------------
# All state lives in one database. DATABASE_URL takes precedence over the parts.
# DATABASE_URL=postgresql://crimson:crimson@localhost:5432/crimson
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimson
POSTGRES_USER=crimson
POSTGRES_PASSWORD=crimson
# Pool sizing per replica, and the startup wait for the DB.
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT=30
# Server-side prepared statements. Unset = DISABLED, which is required behind a
# transaction-mode PgBouncer and harmless otherwise. Set an int only when you
# connect straight to Postgres. Past ~8 API replicas, put PgBouncer in front and
# point DATABASE_URL at :6432 (see deploy/pgbouncer/README.md).
# DB_PREPARE_THRESHOLD=

# --- Scaling / scheduling ---------------------------------------------------
# The Fribb mapping resync rebuilds its tables wholesale, so exactly ONE replica
# may have this true.
# RUN_DB_SYNC=true

# --- Non-anime metadata maintenance (tmdb_shows / tmdb_movies) --------------
# All of this is pinned to the RUN_DB_SYNC replica; leave it at defaults elsewhere.
# Nightly at METADATA_REFRESH_HOUR the oldest 1/BUCKETS of each table is re-pulled,
# so every row refreshes over a full cycle (14 nights) and repeats.
# METADATA_REFRESH_BUCKETS=14
# METADATA_REFRESH_HOUR=4
# Backfill: page TMDB discover to pre-seed the tables. Trigger it anytime from the
# admin dashboard, or run it once at startup with the flag below. ~20 rows/page.
# RUN_METADATA_BACKFILL=false
# METADATA_BACKFILL_PAGES=100

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins. Unset => the built-in dev list. Lock down in prod.
# ALLOWED_ORIGINS=https://crimsonhaven.to,https://www.crimsonhaven.to

# --- Login wall & accounts --------------------------------------------------
# When true (default), every content endpoint needs a valid session token. The auth
# routes, /health, /config, /changelog, the API docs and the signed stream proxies
# stay public. false reopens the whole API.
# REQUIRE_LOGIN=true
#
# Invite code(s) required to register, gating BOTH email+password and mnemonic
# signup (comma-separate for several). EMPTY => registration closed, which fails
# safe for a private site. Single-use Discord-bot tokens work in the same field.
#   openssl rand -hex 12
SIGNUP_INVITE_CODE=
#
# Origin used to build the verification + password-reset links sent by email.
# FRONTEND_BASE_URL=https://crimsonhaven.to
#
# Admin seed (comma-separated). An EXISTING account with a listed email is promoted
# on startup; register/verify it first. Afterwards, promote from the dashboard.
ADMIN_EMAILS=
#
# How long Admin -> Security keeps auth denials, rate-limit trips and admin actions
# before the housekeeping sweep prunes them.
# SECURITY_EVENTS_RETENTION_DAYS=90

# --- Discord invite bot -----------------------------------------------------
# Optional. Its own process (python -m discord_bot); lets ONE whitelisted user mint
# single-use invite tokens by DMing "!invite". Run exactly ONE instance.
#   * Create the bot at https://discord.com/developers/applications -> Bot, copy the
#     token, and enable "Message Content Intent" (needed for server commands; DMs
#     work without it).
#   * DISCORD_OWNER_ID is your numeric Discord user id (Developer Mode ->
#     right-click your name -> Copy User ID). Only this user may use the bot.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# DISCORD_COMMAND_PREFIX=!

# --- SMTP (verification + password reset) -----------------------------------
# Unset SMTP_HOST disables email entirely: registration still works, but nobody can
# verify. SMTP_SECURITY is starttls (default) | ssl | none.
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=service@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=service@example.com
# SMTP_FROM_NAME=CrimsonHaven

# --- Deployment / ops -------------------------------------------------------
# Truthy => 500 responses include exception detail. Leave UNSET in production.
# DEBUG=
# Trusted proxy IPs uvicorn honours X-Forwarded-* from. Usually "*" behind the
# Swarm ingress or a reverse proxy, so client IPs (rate limits, logs) are correct.
# FORWARDED_ALLOW_IPS=
# slowapi rate-limit storage. Default in-memory (per-replica); redis://… shares
# limits across replicas.
# RATE_LIMIT_STORAGE_URI=
# The title the admin Source-Health view probes (defaults to Attack on Titan S1E1),
# and how long a probe sweep is cached.
# HEALTH_CANARY_TITLE=
# HEALTH_CANARY_TMDB=1429
# HEALTH_CANARY_ANILIST=16498
# HEALTH_CANARY_SEASON=1
# HEALTH_CANARY_EPISODE=1
# SOURCE_HEALTH_TTL=300
# Kill-switch for a build-time private source overlay: 0 makes source discovery
# return an empty list without a rebuild. No effect on a base image.
# PRIVATE_SOURCES_ENABLED=1

# --- Logging & observability ------------------------------------------------
# json emits one JSON object per line, which is what you want behind a log shipper.
# LOG_FORMAT=plain
# Shared secret a Prometheus scrape presents to /metrics (X-Metrics-Token or a
# bearer). The route is NOT public: with no token set, only an admin session works.
# METRICS_TOKEN=
# A private Prometheus to back the history charts on Admin -> Metrics. Unset => the
# tab reports that no history is collected. PROMETHEUS_JOB is the scrape job label.
# PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_JOB=crimson-api
# PROMETHEUS_TIMEOUT=12

# --- Demo mode --------------------------------------------------------------
# Powers a public shop-window instance: bypasses the signup invite gate and DELETES
# every non-admin account (and its data) nightly at DEMO_RESET_HOUR. The reset runs
# on the RUN_DB_SYNC replica only. Never set this on anything real.
# DEMO_MODE=false
# DEMO_RESET_HOUR=4

# --- Optional: Ko-fi supporters ---------------------------------------------
# Powers /kofi/webhook + the public /supporters list. Ko-fi has no supporters API,
# only a webhook per payment, so this token authenticates those calls. Find it under
# Ko-fi -> Settings -> Advanced -> Webhooks, and point the webhook at
# https://<your-backend>/kofi/webhook. Unset => the webhook 503s (fails closed).
KOFI_VERIFICATION_TOKEN=
# A subscriber is listed while their last payment is within this many days (Ko-fi
# sends no cancellation event, so this is how the list shrinks). Tippers are kept.
# KOFI_ACTIVE_WINDOW_DAYS=35
# Per-replica cache TTL (seconds) for the public list.
# KOFI_LIST_CACHE_TTL=60

# --- Optional: Changelog (public /changelog from GitHub Releases) -----------
# Releases are cut as published GitHub Releases, so your release notes ARE the
# changelog. A PRIVATE repo works given a read token:
#   * Fine-grained PAT (recommended): Repository -> Contents: Read-only, at
#     https://github.com/settings/tokens?type=beta
#   * ...or a classic token with the `repo` scope.
# Unset => /changelog returns 503.
GITHUB_TOKEN=
# GITHUB_REPO=crimsonhaven-to/crimson-backend
# Cache TTL between refreshes. Conditional ETag requests make these near-free.
# CHANGELOG_CACHE_TTL=1800
# How many releases to surface (max 100), and whether pre-releases count. Drafts are
# always hidden.
# CHANGELOG_MAX_ENTRIES=30
# CHANGELOG_INCLUDE_PRERELEASES=true

# --- Optional: OpenSubtitles (player subtitle tracks) -----------------------
# Adds subtitle tracks to the in-app player (/subtitles). Unset => 503. The key stays
# server-side; the browser only sees a signed, same-origin /subtitles_proxy URL. That
# proxy is the only step that spends your DOWNLOAD quota (searches are free), and
# converted results are cached by file id so an episode never costs quota twice.
# Register a consumer at https://www.opensubtitles.com/en/consumers for a key.
OPENSUBTITLES_API_KEY=
# The API wants a descriptive User-Agent identifying your app.
# OPENSUBTITLES_APP_NAME=CrimsonHaven v1.0
# Seconds to cache a SEARCH result per (title, langs).
# SUBTITLES_SEARCH_TTL=3600
# Fallback signing secret for /subtitles_proxy, used only when PROXY_SECRET is unset.
# SUBTITLES_PROXY_SECRET=

# --- Optional: Manga reading surface ----------------------------------------
# Discovery + metadata come from AniList; the chapter list and page images resolve
# in the VIEWER'S OWN BROWSER via crimson-sources, so the public backend never talks
# to a manga host. On by default; false => the manga routes 503 and the frontend
# drops the row, search results and reader.
# MANGA_ENABLED=true
# Preferred chapter language(s), comma-separated, first is the default. Also handed
# to the client so its own resolution matches.
# MANGA_LANGUAGES=en
# Content ratings to include. Add 'pornographic' to include it (off by default).
# MANGA_CONTENT_RATING=safe,suggestive,erotica
#
# The two below are read ONLY by an optional private server-side manga provider
# (injected via the build-time source overlay), so extension-less devices can read
# too. Dormant in a base build.
# MANGADEX_APP_NAME=CrimsonHaven/1.0
# MANGA_PROXY_SECRET=

# --- Optional: Live TV (IPTV) -----------------------------------------------
# The catalogue is the public iptv-org index, fetched into memory (no key, no DB
# table) and filtered server-side; the project's blocklist is honoured. Playback is
# direct-first, and the signed /iptv_proxy carries only what the browser's own rules
# forbid. On by default; false => the IPTV routes 503 and the client hides the nav.
# IPTV_ENABLED=true
# Hours between catalogue refreshes (upstream publishes daily).
# IPTV_REFRESH_HOURS=12
# IPTV_INCLUDE_NSFW=false
# Fallback signing secret for /iptv_proxy, used only when PROXY_SECRET is unset.
# IPTV_PROXY_SECRET=

# --- Optional: Local media library ------------------------------------------
# There is nothing to switch on: the browsable library follows whichever Local
# sources you register in the admin dashboard.
#
# Fallback secret for the public /local_art poster links (an <img> can't carry the
# bearer, so they're signed instead). Used only when PROXY_SECRET is unset.
# LOCAL_PROXY_SECRET=
# ffmpeg settings for transcoding non-web containers (mkv/avi/…) to HLS on the fly,
# used only by sources with "encoding" enabled.
# LOCAL_HLS_PRESET=veryfast
# LOCAL_HLS_CRF=21
# LOCAL_HLS_AUDIO_BITRATE=160k
# LOCAL_HLS_SEGMENT_SECONDS=6
# LOCAL_HLS_SEGMENT_TIMEOUT=120

# --- Optional: Jellyfin source ----------------------------------------------
# Stream from your own Jellyfin server. JELLYFIN_URL must be reachable from the
# backend container (a LAN/Docker address is fine; it needn't be public).
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_USERNAME=your_jellyfin_user
JELLYFIN_PASSWORD=your_jellyfin_password
# true => the access token is injected at the crimson-proxy EDGE instead of by this
# backend, so those bytes leave the backend too. Needs the proxy's NITRO_JELLYFIN_*.
# JELLYFIN_EDGE_INJECT=false

# --- Optional: Server-side video cache --------------------------------------
# When enabled in the dashboard, playing an episode downloads the complete stream
# (remuxed to mp4 with ffmpeg) to a NAS target you register there, and replays it
# from disk as a named source. The master switch and targets live in the DB; these
# only tune the downloader. ffmpeg must be on PATH (it's in the image).
#
# The download loop runs only on the replica with this true. Defaults true for
# single-container deploys; the Swarm stack sets it true only on cache-worker.
# RUN_CACHE_WORKER=true
# Base URL the downloader uses to reach the backend's own proxies. Loopback by
# default, so cache traffic never leaves the host.
# CACHE_INTERNAL_BASE=http://127.0.0.1:8000
# Concurrent downloads, per-episode timeout (s), required free space (bytes), the
# queue ceiling before new episodes are dropped, and how often the worker polls the
# DB for newly-claimed downloads (seconds, floor 2).
# CACHE_MAX_CONCURRENT=1
# CACHE_DOWNLOAD_TIMEOUT=3600
# CACHE_MIN_FREE_BYTES=2147483648
# CACHE_QUEUE_MAX=200
# CACHE_POLL_INTERVAL=10
# Fallback secret signing the cache replay tickets, used only when PROXY_SECRET is
# unset.
# CACHE_TICKET_SECRET=

# --- Optional: Background downloader (aria2) --------------------------------
# The admin-only downloader takes an http(s) URL or magnet and fetches it via the
# aria2 sidecar, landing the media under <root>/crimson-downloads on the first Local
# source marked "download into this source". The library scanner then surfaces it
# like any other on-disk title. Needs the aria2 service (see the compose/stack files)
# with the media volume mounted into api + aria2 (+ download-worker) at the SAME path.
#
# Shared secret with the sidecar (== aria2's RPC_SECRET). openssl rand -hex 24
ARIA2_RPC_SECRET=
# ARIA2_RPC_URL=http://aria2:6800/jsonrpc
# ARIA2_RPC_TIMEOUT=15
# Only the replica with this true runs the poll loop. Defaults true for
# single-container deploys; the Swarm stack sets it true only on download-worker.
# RUN_DOWNLOAD_WORKER=true
# Concurrent downloads, seconds between status polls, and required free space.
# DOWNLOAD_MAX_ACTIVE=3
# DOWNLOAD_POLL_INTERVAL=5
# DOWNLOAD_MIN_FREE_BYTES=2147483648

# --- Optional: Lumi's chatbot (chat_engine) ---------------------------------
# An in-app chat with the mascot: recommends from a viewer's own history, resolves a
# title to a playable link, and manages their watchlist.
#
# ONLY the provider keys live here. The master switch, provider, model, budgets and
# history depth are operator state in the database (Admin -> Lumi), so changing any
# of them never needs a redeploy. Keys stay out of the DB on purpose, so a dump of
# your accounts never carries billable credentials; the dashboard is told only
# whether each key is present, never its value.
#
# Access is deny-by-default and per-member (Admin -> Users): setting a key here does
# NOT let anyone chat. Both providers may be set at once and switched freely.
#
# Anthropic (Claude). Recommended: best at holding the persona and picking correct
# tool arguments. Default model claude-sonnet-5, ~$3/M in and $15/M out.
ANTHROPIC_API_KEY=
# Google AI Studio (Gemini). Cheaper per token; gemini-3.5-flash-lite is the floor.
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
