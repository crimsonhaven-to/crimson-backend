# Every setting the backend reads, with its default. Only TMDB_API_KEY is
# required. Parsed by core/config.py; booleans accept true/false, 1/0, yes/no,
# on/off, and lists are comma-separated.

# --- Required ---------------------------------------------------------------
# TMDB read access token (v4) or legacy API key.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# --- Signed links -------------------------------------------------------------
# Signs /sign, /subtitles_proxy, /iptv_proxy, /local_art and cache tickets. Must
# be stable and identical on every replica, and equal to each crimson-proxy's
# NITRO_PROXY_SECRET, or signed playback fails with intermittent 403s. Unset uses
# a random per-process secret, which only works for a single dev instance.
# Generate one: openssl rand -hex 32
PROXY_SECRET=
# Per-feature overrides, used only when PROXY_SECRET is unset.
# SUBTITLES_PROXY_SECRET=
# IPTV_PROXY_SECRET=
# LOCAL_PROXY_SECRET=
# CACHE_TICKET_SECRET=

# External crimson-proxy edge hosts that POST /sign mints links for. Several hosts
# give failover, since one signed link is valid on all of them. Unset disables
# /sign (503).
# CRIMSON_PROXY_BASE=https://<site>.netlify.app,https://crimson-proxy.<acct>.workers.dev

# --- Database -------------------------------------------------------------------
# DATABASE_URL wins when set; otherwise the POSTGRES_* parts are used.
# DATABASE_URL=postgresql://crimson:crimson@localhost:5432/crimson
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimson
POSTGRES_USER=crimson
POSTGRES_PASSWORD=crimson
DB_POOL_MIN=1
DB_POOL_MAX=10
# Seconds startup waits for the database.
DB_CONNECT_TIMEOUT=30
# Leave unset behind transaction-mode PgBouncer, where prepared statements break.
# Set an integer (e.g. 5) only for a direct connection. Past about 8 replicas, put
# PgBouncer in front (deploy/pgbouncer/README.md).
# DB_PREPARE_THRESHOLD=

# --- Process roles ----------------------------------------------------------------
# The mapping resync rebuilds tables wholesale: true on exactly one replica.
# RUN_DB_SYNC=true
# The ffmpeg cache loop and the aria2 poll loop each belong on one dedicated
# service. Both default true so a single container works out of the box.
# RUN_CACHE_WORKER=true
# RUN_DOWNLOAD_WORKER=true

# --- Access -------------------------------------------------------------------------
# Every content endpoint requires a session. Auth, /health, the signed proxies
# and the Ko-fi webhook stay public.
# REQUIRE_LOGIN=true
# Reusable invite codes for signup. Empty closes registration (single-use codes
# from the Discord bot still work). Generate one: openssl rand -hex 12
SIGNUP_INVITE_CODE=
# Existing accounts with these emails are promoted to admin at startup.
ADMIN_EMAILS=
# ALLOWED_ORIGINS=https://crimsonhaven.to,https://www.crimsonhaven.to
# In-memory limits are per replica; point at redis://... to share them.
# RATE_LIMIT_STORAGE_URI=memory://
# Includes exception detail in 500 responses. Never in production.
# DEBUG=false

# Open signup, with every non-admin account wiped nightly at DEMO_RESET_HOUR (UTC).
# DEMO_MODE=false
# DEMO_RESET_HOUR=4

# --- Email ----------------------------------------------------------------------------
# Unset SMTP_HOST disables all mail, including verification and password reset.
# SMTP_SECURITY is starttls, ssl or none.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=service@example.com
# SMTP_PASSWORD=
# SMTP_FROM=service@example.com
# SMTP_FROM_NAME=CrimsonHaven
# Origin used in emailed links and the Discord bot's signup hint.
# FRONTEND_BASE_URL=https://crimsonhaven.to

# Mails followers when an episode airs. Off by default, because a wrong send
# cannot be taken back. The dry run claims and logs without sending: watch one run
# before going live. Runs on the RUN_DB_SYNC replica, verified emails only.
# AIRING_NOTIFY_ENABLED=false
# AIRING_NOTIFY_DRY_RUN=false

# SECURITY_EVENTS_RETENTION_DAYS=90

# --- Metadata maintenance (RUN_DB_SYNC replica only) ------------------------------
# Each night the oldest 1/BUCKETS of tmdb_shows and tmdb_movies is re-pulled,
# because TMDB never says when a row changed.
# METADATA_REFRESH_BUCKETS=14
# METADATA_REFRESH_HOUR=4
# Pre-populate from TMDB discover at startup. Also available from the dashboard.
# RUN_METADATA_BACKFILL=false
# METADATA_BACKFILL_PAGES=100

# --- Sources -----------------------------------------------------------------------------
# Your own Jellyfin, reachable from the backend container.
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_USERNAME=your_jellyfin_user
JELLYFIN_PASSWORD=your_jellyfin_password
# Inject the Jellyfin token at the crimson-proxy edge instead of this backend.
# JELLYFIN_EDGE_INJECT=false

# Build-time overlay sources. Off in demo and CI builds.
# PRIVATE_SOURCES_ENABLED=true

# --- Subtitles (OpenSubtitles) -----------------------------------------------------------
# Unset disables /subtitles. Register an app at https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_APP_NAME=CrimsonHaven v1.0
# Seconds a search result is cached. Searches are free; downloads spend quota.
# SUBTITLES_SEARCH_TTL=3600

# --- Manga -----------------------------------------------------------------------------
# Discovery is AniList; chapters resolve in the browser unless an overlay provider
# is present. Languages: first is the default. Add "pornographic" to opt in.
# MANGA_ENABLED=true
# MANGA_LANGUAGES=en
# MANGA_CONTENT_RATING=safe,suggestive,erotica
# Read by the overlay's provider only.
# MANGADEX_APP_NAME=CrimsonHaven/1.0
# MANGA_PROXY_SECRET=

# --- Live TV (iptv-org) -------------------------------------------------------------------
# IPTV_ENABLED=true
# IPTV_INCLUDE_NSFW=false
# IPTV_REFRESH_HOURS=12

# --- Server-side video cache -----------------------------------------------------------------
# The switch and NAS targets live in the dashboard; these tune the downloader.
# Loopback, so cache traffic never leaves the host or meets the login wall.
# CACHE_INTERNAL_BASE=http://127.0.0.1:8000
# CACHE_MAX_CONCURRENT=1
# CACHE_DOWNLOAD_TIMEOUT=3600
# CACHE_QUEUE_MAX=200
# CACHE_POLL_INTERVAL=10
# CACHE_MIN_FREE_BYTES=2147483648

# --- Background downloads (aria2 sidecar) ---------------------------------------------------
# Must equal aria2's RPC_SECRET. Generate one: openssl rand -hex 24
ARIA2_RPC_SECRET=
# ARIA2_RPC_URL=http://aria2:6800/jsonrpc
# DOWNLOAD_MAX_ACTIVE=3
# DOWNLOAD_POLL_INTERVAL=5
# DOWNLOAD_MIN_FREE_BYTES=2147483648

# --- Lumi chatbot ------------------------------------------------------------------------------
# Only the keys live here, so a database dump never carries billable credentials.
# Switch, provider, model and budgets are set in Admin -> Lumi, and access is
# granted per member. GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Observability --------------------------------------------------------------------------------
# plain or json.
# LOG_FORMAT=plain
# Lets a Prometheus scrape reach /metrics. Unset means admin sessions only.
# METRICS_TOKEN=
# Gives the dashboard's Metrics tab history charts.
# PROMETHEUS_URL=http://prometheus:9090
# The title the Source Health view probes every scrape source with.
# HEALTH_CANARY_TITLE=Attack on Titan
# HEALTH_CANARY_TMDB=1429
# HEALTH_CANARY_SEASON=1
# HEALTH_CANARY_EPISODE=1
# HEALTH_CANARY_ANILIST=16498

# --- Integrations -------------------------------------------------------------------------------------
# Ko-fi webhook secret (Ko-fi -> Settings -> Advanced -> Webhooks). Unset makes
# POST /kofi/webhook fail closed. Ko-fi sends no cancellation event, so a
# subscriber drops off the list this many days after their last payment.
KOFI_VERIFICATION_TOKEN=
# KOFI_ACTIVE_WINDOW_DAYS=35
# KOFI_LIST_CACHE_TTL=60

# /changelog serves this repo's GitHub Releases. Unset GITHUB_TOKEN returns 503.
# A read-only fine-grained token (Contents: Read) is enough.
GITHUB_TOKEN=
# GITHUB_REPO=crimsonhaven-to/crimson-backend
# CHANGELOG_CACHE_TTL=1800
# CHANGELOG_MAX_ENTRIES=30
# CHANGELOG_INCLUDE_PRERELEASES=true

# Discord invite bot (python -m discord_bot), run as exactly one instance. It
# needs the Message Content intent, and only DISCORD_OWNER_ID may use it.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# DISCORD_COMMAND_PREFIX=!
