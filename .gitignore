# local development stuff
*pycache*
/.claude

# test/lint tooling caches + the throwaway local test venv (CI uses its own)
.venv-test/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# secrets
.env

# temporary until DB generation is done
*.db
*.db-journal
*.db-wal
*.db-shm

# ad-hoc local db dumps / scratch SQL
*.sql
# ...but the versioned schema migrations are tracked: they must ship in the image,
# or a deployed container finds zero migration files and reports itself up to date
# while actually being unmigrated. See core/migrations.py.
!migrations/*.sql