# The Dockerfile copies explicit paths, so this list only keeps the build context
# small and keeps secrets and local state out of it.
.git
.gitignore
.gitlab-ci.yml
.vscode
.claude
.env
*.env
!.env.example

# State lives in PostgreSQL; a stray local SQLite file must never reach the image.
*.db
*.db-journal
*.db-wal
*.db-shm

# Python caches / artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Dev and CI only: the CI `gate` job runs the tests outside the image.
tests/
.venv-test/
requirements-dev.txt
pyproject.toml
scripts/
graphify-out/

# Generated API contract, used by the frontend and tests, not at runtime.
openapi.json
contracts/

# Deployment files are applied on the hosts, never inside the app container.
deploy/
docker-compose*.yml
docker-stack.yml

# Docs
docs/
**/*.md
